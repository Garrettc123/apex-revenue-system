# ─────────────────────────────────────────────────────────────
# Apex Revenue System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to source control.
# ─────────────────────────────────────────────────────────────

# Google Gemini AI (required for /genesis, /ai/leads, /ai/analyze)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Coinbase Commerce (required for /checkout/<plan> and /webhook/coinbase)
# Create an account at: https://commerce.coinbase.com
COINBASE_API_KEY=your_coinbase_commerce_api_key_here
COINBASE_WEBHOOK_SECRET=your_coinbase_webhook_secret_here

# Public base URL of your deployment (used for Coinbase redirect URLs)
# For Railway: https://<your-service>.up.railway.app
BASE_URL=https://apex-revenue-system.up.railway.app

# Railway deployment token (used by GitHub Actions to deploy)
# Generate at: https://railway.app/account/tokens
RAILWAY_TOKEN=your_railway_token_here

# Flask development only — do NOT set in production
# PORT is set automatically by Railway
PORT=8080
REVENUE_DB_FILE=./data/revenue_engine.db

# ─────────────────────────────────────────────────────────────
# Edge Node Configuration (Pixel 10)
# ─────────────────────────────────────────────────────────────

# Bearer token the Pixel 10 presents when connecting to the controller.
# Generate a strong random token and share it with the device securely.
PIXEL_10_NODE_TOKEN=your_pixel_10_node_token_here

# HMAC secret for verifying webhook payloads from/to edge nodes.
EDGE_WEBHOOK_SECRET=your_edge_webhook_hmac_secret_here

# ─────────────────────────────────────────────────────────────
# Shopify (required for /webhook/shopify)
# Admin API token: Shopify Admin > Apps > Develop apps
# ─────────────────────────────────────────────────────────────
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_hmac_secret_here
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_your_admin_api_token_here

# ─────────────────────────────────────────────────────────────
# Stripe (extended — billing portal and HMAC verification)
# https://dashboard.stripe.com/apikeys
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_PRICE_ID_STARTER=price_starter_here
STRIPE_PRICE_ID_PRO=price_pro_here
STRIPE_PRICE_ID_ENTERPRISE=price_enterprise_here

# ─────────────────────────────────────────────────────────────
# HubSpot (deal creation on new orders)
# https://app.hubspot.com/private-apps
# ─────────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# ─────────────────────────────────────────────────────────────
# Supabase (tenant provisioning on new customers)
# https://app.supabase.com/project/<id>/settings/api
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─────────────────────────────────────────────────────────────
# Linear (onboarding project creation on every sale)
# https://linear.app/settings/api
# ─────────────────────────────────────────────────────────────
LINEAR_API_KEY=lin_api_your_linear_api_key_here
LINEAR_TEAM_ID=your_linear_team_id_here

# ─────────────────────────────────────────────────────────────
# Notion (client workspace creation on Linear project)
# https://www.notion.so/my-integrations
# ─────────────────────────────────────────────────────────────
NOTION_TOKEN=secret_your_notion_integration_token_here
NOTION_PARENT_PAGE_ID=your_notion_parent_page_id_here

# ─────────────────────────────────────────────────────────────
# DocuSign (IRAS contract auto-delivery)
# Production: https://admin.docusign.com/apps-and-keys
# Sandbox/demo: https://admindemo.docusign.com/apps-and-keys
# ─────────────────────────────────────────────────────────────
DOCUSIGN_ACCESS_TOKEN=your_docusign_oauth_access_token_here
DOCUSIGN_ACCOUNT_ID=your_docusign_account_id_here
DOCUSIGN_TEMPLATE_ID=your_docusign_iras_template_id_here
DOCUSIGN_BASE_URI=https://na4.docusign.net

# ─────────────────────────────────────────────────────────────
# Hunter.io (IRAS prospecting feed)
# https://hunter.io/api-keys
# ─────────────────────────────────────────────────────────────
HUNTER_API_KEY=your_hunter_api_key_here
CLEARBIT_API_KEY=your_clearbit_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
