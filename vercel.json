{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "main.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,**/*.test.py,**/test_*.py,.github/**,docs/**,.git/**,package*.json,package-lock.json,conftest.py,src/swagger/**}"
    },
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,**/*.test.py,**/test_*.py,.github/**,docs/**,.git/**,package*.json,package-lock.json,conftest.py}"
    }
  }
}
